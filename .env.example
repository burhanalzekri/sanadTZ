# سند تعز — انسخ الملف إلى .env وأدخل بياناتك. لا ترفع .env إلى Git.

# PostgreSQL (Neon أو أي PostgreSQL متاح)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# سر الجلسات؛ أنشئه مرة واحدة واحتفظ به ثابتاً ما دامت هناك جلسات أو بيانات قديمة
SESSION_SECRET=ضع_هنا_قيمة_عشوائية_طويلة_وثابتة

# مفتاح منفصل لتشفير بيانات التواصل في الحجوزات؛ أنشئه بـ openssl rand -hex 32 واحتفظ به ثابتاً
BOOKING_ENCRYPTION_KEY=ضع_هنا_مفتاحاً_عشوائياً_مستقلاً_وطويلاً

# إنشاء حساب المدير الأول تلقائياً عند أول تشغيل (كلمة المرور 12 حرفاً على الأقل)
ADMIN_NAME=مدير سند
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=غيّر_هذه_الكلمة_إلى_كلمة_قوية_جداً

# اتركه فارغاً/true على HTTPS؛ false يُقبل فقط مع NODE_ENV=development على localhost HTTP
COOKIE_SECURE=

# المنافذ
PORT=5000
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:5000
NODE_ENV=development
LOG_LEVEL=info

# Origins المسموح لها بطلب API مع ملفات تعريف الارتباط وطلبات تغيير الحالة (في الإنتاج)
# مثال: CORS_ORIGINS=https://sanad.example.com,https://www.sanad.example.com
CORS_ORIGINS=
